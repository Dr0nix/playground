<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="playground.model.mapper.JavaMethodQuizMapp">
    <select id="getQuizCount" resultType="int">
        SELECT
            COUNT(*)
        FROM
            quiz.java_method
        WHERE
            1=1
    </select>

    <select id="getQuizByNo" parameterType="long" resultType="JavaMethodQuizDTO">
        SELECT
            *
        FROM
            quiz.java_method
        WHERE
            1=1
          AND
            quiz_no = #{quizNo}
    </select>

    <select id="getQuizList" resultType="playground.model.dto.JavaMethodQuizDTO">
        SELECT
            *
        FROM
            quiz.java_method
        WHERE
            1=1
    </select>
</mapper>
